# ============================================
# Claude SaaS Template — .gitignore
# ============================================

# Subproyectos: cada uno es repo independiente (repos con su propio git/remoto)
proyectos/
crm/
crm-v2/

# Dependencias (nunca se versionan en el madre)
node_modules/

# Backups y temporales de trabajo (no son parte del template)
*.backup*
.tmp-*
.playwright-mcp/

# Python cache de los scripts de skills
__pycache__/
*.pyc

# Secretos
.env
.env.*
!.env.example

# Claude Code locales
CLAUDE.local.md
.claude/settings.local.json
# launch.json = config de máquina (puertos/paths del dev server), no del template.
# OJO: .claude/ SÍ se versiona (agents + skills son parte del template) → ignorar
# el archivo puntual, nunca la carpeta.
.claude/launch.json
.mdd/

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Outputs locales sensibles
outputs/**/*.local.*

# Editores
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
logs/
*.log
tmp/
temp/

# Material de referencia personal con copyright (libros, etc.)
# No subir al repo — bloat + zona gris legal
docs/books/
